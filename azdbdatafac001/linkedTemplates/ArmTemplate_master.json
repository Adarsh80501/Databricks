{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azdbdatafac001"
		},
		"azlinkedDataLakeService_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'azlinkedDataLakeService'"
		},
		"azlinkedservice_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'azlinkedservice'"
		},
		"azlinkedDataLakeService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azdbstorageacc001.dfs.core.windows.net/"
		},
		"azlinkedservice_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azdbdbserver.database.windows.net"
		},
		"azlinkedservice_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azsqldb"
		},
		"azlinkedservice_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "azure"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azdbdatafac001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"azlinkedDataLakeService_accountKey": {
						"value": "[parameters('azlinkedDataLakeService_accountKey')]"
					},
					"azlinkedservice_password": {
						"value": "[parameters('azlinkedservice_password')]"
					},
					"azlinkedDataLakeService_properties_typeProperties_url": {
						"value": "[parameters('azlinkedDataLakeService_properties_typeProperties_url')]"
					},
					"azlinkedservice_properties_typeProperties_server": {
						"value": "[parameters('azlinkedservice_properties_typeProperties_server')]"
					},
					"azlinkedservice_properties_typeProperties_database": {
						"value": "[parameters('azlinkedservice_properties_typeProperties_database')]"
					},
					"azlinkedservice_properties_typeProperties_userName": {
						"value": "[parameters('azlinkedservice_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}